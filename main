    <script>
        // =========================================================================
        // AUDIO SYNTHESIZER (Web Audio API - zero external assets needed)
        // =========================================================================
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playShoot(pitchOffset = 0) {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(520 + pitchOffset, now);
                osc.frequency.exponentialRampToValueAtTime(110, now + 0.09);
                gain.gain.setValueAtTime(0.12, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.09);
            }

            playHit() {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(190, now);
                osc.frequency.exponentialRampToValueAtTime(55, now + 0.07);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.07);
            }

            playExplosion(size = 1) {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const dur = 0.16 * size;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(140, now);
                osc.frequency.exponentialRampToValueAtTime(28, now + dur);
                gain.gain.setValueAtTime(Math.min(0.24, 0.14 * size), now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + dur);
            }

            playDash() {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.14);
                gain.gain.setValueAtTime(0.16, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.14);
            }

            playPowerup() {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const notes = [440, 554.37, 659.25, 880];
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.06);
                    gain.gain.setValueAtTime(0.12, now + idx * 0.06);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.06 + 0.15);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.06);
                    osc.stop(now + idx * 0.06 + 0.15);
                });
            }

            playNova() {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(640, now);
                osc.frequency.exponentialRampToValueAtTime(35, now + 0.55);
                gain.gain.setValueAtTime(0.28, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.55);
            }
        }

        const sfx = new SoundFX();

        // =========================================================================
        // CANVAS & INPUT SETUP
        // =========================================================================
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const keys = {};
        const mouse = { x: width / 2, y: height / 2, down: false, autoFire: false };

        window.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            keys[k] = true;

            if (k === 'f') {
                mouse.autoFire = !mouse.autoFire;
                spawnFloatingText(player.x, player.y - 30, mouse.autoFire ? 'AUTO-FIRE ON' : 'AUTO-FIRE OFF', '#00f3ff');
            }
            if ((k === ' ' || k === 'shift') && gameState === 'PLAYING') {
                e.preventDefault();
                triggerDash();
            }
            if ((k === 'q' || k === 'e') && gameState === 'PLAYING') {
                triggerNova();
            }
            if ((k === 'escape' || k === 'p') && (gameState === 'PLAYING' || gameState === 'PAUSED')) {
                togglePause();
            }
        });

        window.addEventListener('keyup', (e) => {
            keys[e.key.toLowerCase()] = false;
        });

        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        window.addEventListener('mousedown', (e) => {
            sfx.init();
            if (e.button === 0) mouse.down = true;
            if (e.button === 2 && gameState === 'PLAYING') triggerNova();
        });

        window.addEventListener('mouseup', (e) => {
            if (e.button === 0) mouse.down = false;
        });

        window.addEventListener('contextmenu', (e) => e.preventDefault());

        // =========================================================================
        // GAME STATE & ENTITIES
        // =========================================================================
        let gameState = 'START'; // START, PLAYING, UPGRADE, PAUSED, GAMEOVER
        let score = 0;
        let bestScore = Number(localStorage.getItem('neon_overdrive_best') || 0);
        document.getElementById('bestScoreText').textContent = bestScore;

        let wave = 1;
        let waveTimer = 0;
        let enemiesKilled = 0;
        let combo = 1;
        let comboTimer = 0;
        let screenShake = 0;
        let gridPulse = 0;

        let player;
        let bullets = [];
        let enemyBullets = [];
        let enemies = [];
        let particles = [];
        let xpGems = [];
        let shockwaves = [];
        let floatingTexts = [];
        let orbitals = [];

        const UPGRADE_POOL = [
            {
                id: 'multishot',
                icon: '⚡',
                title: 'SPLIT BARREL',
                tag: 'WEAPONRY',
                desc: '+1 additional plasma projectile per shot with wider spread.',
                apply: (p) => { p.projectiles += 1; }
            },
            {
                id: 'firerate',
                icon: '🔥',
                title: 'OVERCLOCKED CYCLER',
                tag: 'SPEED',
                desc: 'Increases weapon fire rate by +25% and bullet velocity by +15%.',
                apply: (p) => { p.fireDelay *= 0.8; p.bulletSpeed *= 1.15; }
            },
            {
                id: 'pierce',
                icon: '💠',
                title: 'RAILGUN SABOT',
                tag: 'BALLISTICS',
                desc: 'Rounds pierce through +1 additional target and deal +20% damage.',
                apply: (p) => { p.pierce += 1; p.damage *= 1.2; }
            },
            {
                id: 'orbital',
                icon: '🛰️',
                title: 'AEGIS DRONE',
                tag: 'DEFENSE',
                desc: 'Deploys an autonomous plasma sentinel that orbits and shreds enemies.',
                apply: (p) => {
                    p.orbitalCount += 1;
                    rebuildOrbitals();
                }
            },
            {
                id: 'ricochet',
                icon: '🪃',
                title: 'RICOCHET MATRIX',
                tag: 'TACTICAL',
                desc: 'Projectiles bounce off arena walls +1 time and gain +15% damage.',
                apply: (p) => { p.bounces += 1; p.damage *= 1.15; }
            },
            {
                id: 'hull',
                icon: '🛡️',
                title: 'NANITE REPAIR & HULL',
                tag: 'SURVIVABILITY',
                desc: 'Restores 50% Shield HP immediately, +35 Max HP, and +1 EMP Nova charge.',
                apply: (p) => {
                    p.maxHp += 35;
                    p.hp = Math.min(p.maxHp, p.hp + p.maxHp * 0.5);
                    p.novas += 1;
                }
            },
            {
                id: 'thrusters',
                icon: '🚀',
                title: 'HYPERION THRUSTERS',
                tag: 'MOBILITY',
                desc: '+20% movement speed, wider XP magnet radius, and -25% Dash cooldown.',
                apply: (p) => {
                    p.speed *= 1.2;
                    p.magnetRadius *= 1.35;
                    p.dashCooldownMax *= 0.75;
                }
            }
        ];

        function resetGame() {
            player = {
                x: width / 2,
                y: height / 2,
                vx: 0,
                vy: 0,
                radius: 16,
                angle: 0,
                speed: 310,
                hp: 100,
                maxHp: 100,
                xp: 0,
                xpToNext: 80,
                level: 1,
                fireTimer: 0,
                fireDelay: 0.18,
                bulletSpeed: 740,
                damage: 26,
                projectiles: 1,
                pierce: 0,
                bounces: 0,
                orbitalCount: 0,
                magnetRadius: 150,
                dashTimer: 0,
                dashDuration: 0.22,
                dashCooldown: 0,
                dashCooldownMax: 2.2,
                invulnTimer: 0,
                novas: 2
            };

            bullets = [];
            enemyBullets = [];
            enemies = [];
            particles = [];
            xpGems = [];
            shockwaves = [];
            floatingTexts = [];
            orbitals = [];

            score = 0;
            wave = 1;
            waveTimer = 0;
            enemiesKilled = 0;
            combo = 1;
            comboTimer = 0;
            screenShake = 0;

            spawnWave(1);
            updateHUD();
        }

        function rebuildOrbitals() {
            orbitals = [];
            for (let i = 0; i < player.orbitalCount; i++) {
                orbitals.push({
                    angleOffset: (Math.PI * 2 * i) / player.orbitalCount,
                    dist: 58,
                    radius: 7
                });
            }
        }

        // =========================================================================
        // ACTIONS: DASH, NOVA, SHOOTING
        // =========================================================================
        function triggerDash() {
            if (player.dashCooldown > 0) return;
            sfx.playDash();
            player.dashTimer = player.dashDuration;
            player.dashCooldown = player.dashCooldownMax;
            player.invulnTimer = Math.max(player.invulnTimer, player.dashDuration + 0.12);

            // Dash direction from input or mouse aim
            let dx = 0, dy = 0;
            if (keys['w'] || keys['arrowup']) dy -= 1;
            if (keys['s'] || keys['arrowdown']) dy += 1;
            if (keys['a'] || keys['arrowleft']) dx -= 1;
            if (keys['d'] || keys['arrowright']) dx += 1;

            if (dx === 0 && dy === 0) {
                dx = Math.cos(player.angle);
                dy = Math.sin(player.angle);
            } else {
                const len = Math.hypot(dx, dy);
                dx /= len;
                dy /= len;
            }

            player.vx = dx * player.speed * 3.1;
            player.vy = dy * player.speed * 3.1;

            // Shockwave ring on dash
            shockwaves.push({
                x: player.x,
                y: player.y,
                radius: 10,
                maxRadius: 95,
                color: '#d500f9',
                alpha: 0.9,
                lineWidth: 4
            });
        }

        function triggerNova() {
            if (player.novas <= 0) {
                spawnFloatingText(player.x, player.y - 28, 'NO EMP CHARGES', '#ff1744');
                return;
            }
            player.novas -= 1;
            sfx.playNova();
            screenShake = 18;
            player.invulnTimer = Math.max(player.invulnTimer, 0.8);

            shockwaves.push({
                x: player.x,
                y: player.y,
                radius: 20,
                maxRadius: Math.max(width, height) * 0.65,
                color: '#00f3ff',
                alpha: 1,
                lineWidth: 10
            });

            // Clear enemy bullets
            enemyBullets.forEach((b) => {
                spawnParticles(b.x, b.y, '#00f3ff', 4);
            });
            enemyBullets = [];

            // Damage all enemies on screen
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                const dist = Math.hypot(e.x - player.x, e.y - player.y);
                if (dist < Math.max(width, height) * 0.7) {
                    damageEnemy(e, player.damage * 4.5 + 60, true);
                }
            }
            updateHUD();
        }

        function fireWeapon() {
            sfx.playShoot((Math.random() - 0.5) * 60);
            const count = player.projectiles;
            const spreadArc = Math.min(0.55, (count - 1) * 0.11);

            for (let i = 0; i < count; i++) {
                const offset = count === 1 ? 0 : -spreadArc / 2 + (spreadArc / (count - 1)) * i;
                const ang = player.angle + offset;

                bullets.push({
                    x: player.x + Math.cos(ang) * 20,
                    y: player.y + Math.sin(ang) * 20,
                    vx: Math.cos(ang) * player.bulletSpeed,
                    vy: Math.sin(ang) * player.bulletSpeed,
                    radius: 4.5,
                    damage: player.damage,
                    pierce: player.pierce,
                    bounces: player.bounces,
                    hitIds: new Set(),
                    color: player.pierce > 0 ? '#00e676' : '#00f3ff'
                });
            }

            // Subtle recoil & muzzle particles
            const muzzleX = player.x + Math.cos(player.angle) * 22;
            const muzzleY = player.y + Math.sin(player.angle) * 22;
            spawnParticles(muzzleX, muzzleY, '#00f3ff', 3, 120);
        }

        // =========================================================================
        // ENEMY SPAWNING & AI
        // =========================================================================
        let nextEnemyId = 1;

        function spawnEnemy(type) {
            // Spawn along arena edge
            const margin = 40;
            let x, y;
            if (Math.random() < 0.5) {
                x = Math.random() < 0.5 ? -margin : width + margin;
                y = Math.random() * height;
            } else {
                x = Math.random() * width;
                y = Math.random() < 0.5 ? -margin : height + margin;
            }

            const scale = 1 + (wave - 1) * 0.16;

            const templates = {
                chaser: {
                    radius: 14,
                    hp: 32 * scale,
                    speed: 155 + Math.min(90, wave * 6),
                    color: '#ff1744',
                    xp: 16,
                    score: 100,
                    sides: 3
                },
                dasher: {
                    radius: 13,
                    hp: 26 * scale,
                    speed: 225 + Math.min(110, wave * 8),
                    color: '#ffea00',
                    xp: 22,
                    score: 150,
                    sides: 4
                },
                shooter: {
                    radius: 17,
                    hp: 48 * scale,
                    speed: 110 + Math.min(60, wave * 4),
                    color: '#d500f9',
                    xp: 30,
                    score: 220,
                    sides: 5,
                    shootTimer: 1.5 + Math.random()
                },
                tank: {
                    radius: 26,
                    hp: 150 * scale,
                    speed: 78 + Math.min(40, wave * 3),
                    color: '#ff6d00',
                    xp: 65,
                    score: 450,
                    sides: 6
                },
                boss: {
                    radius: 42,
                    hp: 620 * scale,
                    speed: 92,
                    color: '#ff00e5',
                    xp: 240,
                    score: 2000,
                    sides: 8,
                    shootTimer: 1.1
                }
            };

            const t = templates[type] || templates.chaser;
            enemies.push({
                id: nextEnemyId++,
                type,
                x,
                y,
                vx: 0,
                vy: 0,
                radius: t.radius,
                hp: t.hp,
                maxHp: t.hp,
                speed: t.speed,
                color: t.color,
                xp: t.xp,
                score: t.score,
                sides: t.sides,
                angle: 0,
                shootTimer: t.shootTimer || 0,
                flashTimer: 0
            });
        }

        function spawnWave(waveNum) {
            const baseCount = 6 + waveNum * 3;
            for (let i = 0; i < baseCount; i++) {
                const r = Math.random();
                if (waveNum >= 4 && r < 0.14) spawnEnemy('tank');
                else if (waveNum >= 3 && r < 0.34) spawnEnemy('shooter');
                else if (waveNum >= 2 && r < 0.58) spawnEnemy('dasher');
                else spawnEnemy('chaser');
            }

            if (waveNum % 5 === 0) {
                spawnEnemy('boss');
                spawnFloatingText(width / 2, height * 0.25, `⚠️ DREADNOUGHT DETECTED ⚠️`, '#ff00e5');
            } else {
                spawnFloatingText(width / 2, height * 0.25, `WAVE ${waveNum} INCOMING`, '#00f3ff');
            }
        }

        function damageEnemy(e, amount, isCrit = false) {
            e.hp -= amount;
            e.flashTimer = 0.08;
            sfx.playHit();

            if (e.hp <= 0) {
                killEnemy(e);
            } else if (isCrit) {
                spawnFloatingText(e.x, e.y - e.radius, Math.round(amount), '#ffea00');
            }
        }

        function killEnemy(e) {
            const idx = enemies.indexOf(e);
            if (idx !== -1) enemies.splice(idx, 1);

            sfx.playExplosion(e.type === 'boss' ? 2.2 : e.type === 'tank' ? 1.4 : 0.9);
            screenShake = Math.min(20, screenShake + (e.type === 'boss' ? 14 : 4));
            gridPulse = 1;

            spawnParticles(e.x, e.y, e.color, e.type === 'boss' ? 45 : 16, 230);

            shockwaves.push({
                x: e.x,
                y: e.y,
                radius: e.radius * 0.6,
                maxRadius: e.radius * 2.8,
                color: e.color,
                alpha: 0.75,
                lineWidth: 3
            });

            // Combo & Score
            combo = Math.min(10, +(combo + 0.15).toFixed(2));
            comboTimer = 3.5;
            const pts = Math.round(e.score * combo);
            score += pts;
            enemiesKilled += 1;

            if (score > bestScore) {
                bestScore = score;
                localStorage.setItem('neon_overdrive_best', bestScore);
            }

            spawnFloatingText(e.x, e.y, `+${pts}`, e.color);

            // Drop XP Gem
            xpGems.push({
                x: e.x,
                y: e.y,
                vx: (Math.random() - 0.5) * 90,
                vy: (Math.random() - 0.5) * 90,
                val: e.xp,
                radius: e.type === 'boss' ? 10 : 6,
                color: e.type === 'boss' ? '#ff00e5' : '#00e676'
            });

            // Boss or Tank chance to drop a health orb
            if (e.type === 'boss' || (e.type === 'tank' && Math.random() < 0.35)) {
                xpGems.push({
                    x: e.x + 12,
                    y: e.y + 12,
                    vx: (Math.random() - 0.5) * 60,
                    vy: (Math.random() - 0.5) * 60,
                    val: 0,
                    heal: 25,
                    radius: 8,
                    color: '#ff1744'
                });
            }

            updateHUD();
        }

        // =========================================================================
        // PARTICLES & VISUAL FX
        // =========================================================================
        function spawnParticles(x, y, color, count = 12, maxSpeed = 190) {
            for (let i = 0; i < count; i++) {
                const ang = Math.random() * Math.PI * 2;
                const spd = 30 + Math.random() * maxSpeed;
                particles.push({
                    x,
                    y,
                    vx: Math.cos(ang) * spd,
                    vy: Math.sin(ang) * spd,
                    life: 0.35 + Math.random() * 0.35,
                    maxLife: 0.7,
                    size: 2 + Math.random() * 3.5,
                    color
                });
            }
        }

        function spawnFloatingText(x, y, text, color = '#fff') {
            floatingTexts.push({
                x,
                y,
                text: String(text),
                color,
                life: 0.85,
                maxLife: 0.85
            });
        }

        // =========================================================================
        // LEVEL UP & UI SCREENS
        // =========================================================================
        function checkLevelUp() {
            if (player.xp >= player.xpToNext) {
                player.xp -= player.xpToNext;
                player.level += 1;
                player.xpToNext = Math.round(player.xpToNext * 1.32 + 25);
                sfx.playPowerup();
                showUpgradeScreen();
            }
        }

        function showUpgradeScreen() {
            gameState = 'UPGRADE';
            mouse.down = false;
            const container = document.getElementById('upgradeCardsContainer');
            container.innerHTML = '';

            // Pick 3 random distinct upgrades
            const shuffled = [...UPGRADE_POOL].sort(() => Math.random() - 0.5).slice(0, 3);
            shuffled.forEach((upg) => {
                const card = document.createElement('div');
                card.className = 'upgrade-card';
                card.innerHTML = `
          <div>
            <div class="upgrade-icon">${upg.icon}</div>
            <div class="upgrade-tag">${upg.tag}</div>
            <div class="upgrade-title">${upg.title}</div>
          </div>
          <div class="upgrade-desc">${upg.desc}</div>
        `;
                card.addEventListener('click', () => {
                    upg.apply(player);
                    document.getElementById('upgradeScreen').classList.add('hidden');
                    gameState = 'PLAYING';
                    spawnFloatingText(player.x, player.y - 30, `${upg.title} INSTALLED!`, '#00e676');
                    updateHUD();
                });
                container.appendChild(card);
            });

            document.getElementById('upgradeScreen').classList.remove('hidden');
        }

        function togglePause() {
            if (gameState === 'PLAYING') {
                gameState = 'PAUSED';
                spawnFloatingText(player.x, player.y - 40, 'SYSTEM PAUSED', '#00f3ff');
            } else if (gameState === 'PAUSED') {
                gameState = 'PLAYING';
            }
        }

        function triggerGameOver() {
            gameState = 'GAMEOVER';
            sfx.playExplosion(2.5);
            document.getElementById('finalScore').textContent = score.toLocaleString();
            document.getElementById('finalBest').textContent = bestScore.toLocaleString();
            document.getElementById('finalWave').textContent = wave;
            document.getElementById('finalKills').textContent = enemiesKilled;
            document.getElementById('finalLevel').textContent = player.level;
            document.getElementById('gameOverScreen').classList.remove('hidden');
        }

        function updateHUD() {
            if (!player) return;
            const hpPct = Math.max(0, (player.hp / player.maxHp) * 100);
            document.getElementById('hpBar').style.width = `${hpPct}%`;
            document.getElementById('hpText').textContent = `${Math.ceil(Math.max(0, player.hp))} / ${player.maxHp}`;

            const xpPct = Math.min(100, (player.xp / player.xpToNext) * 100);
            document.getElementById('xpBar').style.width = `${xpPct}%`;
            document.getElementById('xpText').textContent = `${Math.floor(player.xp)} / ${player.xpToNext} XP`;
            document.getElementById('lvlText').textContent = player.level;

            const dashReadyPct = player.dashCooldown <= 0
                ? 100
                : Math.max(0, (1 - player.dashCooldown / player.dashCooldownMax) * 100);
            document.getElementById('dashBar').style.width = `${dashReadyPct}%`;
            document.getElementById('dashText').textContent = player.dashCooldown <= 0 ? 'READY' : `${player.dashCooldown.toFixed(1)}s`;

            document.getElementById('waveText').textContent = `WAVE ${wave}`;
            document.getElementById('enemiesText').textContent = `HOSTILES ACTIVE: ${enemies.length}`;
            document.getElementById('scoreText').textContent = score.toLocaleString();
            document.getElementById('bestScoreText').textContent = bestScore.toLocaleString();
            document.getElementById('comboText').textContent = `${combo.toFixed(1)}x OVERDRIVE`;
            document.getElementById('novaCountText').textContent = player.novas;
        }

        // =========================================================================
        // MAIN UPDATE LOOP
        // =========================================================================
        let lastTime = performance.now();

        function update(dt) {
            if (gameState !== 'PLAYING') return;

            // Screen Shake & Grid pulse decay
            if (screenShake > 0) screenShake = Math.max(0, screenShake - dt * 35);
            if (gridPulse > 0) gridPulse = Math.max(0, gridPulse - dt * 2.5);

            // Combo timer
            if (comboTimer > 0) {
                comboTimer -= dt;
                if (comboTimer <= 0) {
                    combo = 1;
                    updateHUD();
                }
            }

            // Wave progression
            waveTimer += dt;
            if (enemies.length === 0 || waveTimer > 22) {
                wave += 1;
                waveTimer = 0;
                spawnWave(wave);
                updateHUD();
            }

            // Player Movement
            player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);

            if (player.dashCooldown > 0) {
                player.dashCooldown = Math.max(0, player.dashCooldown - dt);
            }
            if (player.invulnTimer > 0) {
                player.invulnTimer = Math.max(0, player.invulnTimer - dt);
            }

            if (player.dashTimer > 0) {
                player.dashTimer -= dt;
                spawnParticles(player.x, player.y, '#d500f9', 2, 60);
            } else {
                let mx = 0, my = 0;
                if (keys['w'] || keys['arrowup']) my -= 1;
                if (keys['s'] || keys['arrowdown']) my += 1;
                if (keys['a'] || keys['arrowleft']) mx -= 1;
                if (keys['d'] || keys['arrowright']) mx += 1;

                if (mx !== 0 || my !== 0) {
                    const len = Math.hypot(mx, my);
                    mx /= len;
                    my /= len;
                }

                const accel = 14;
                player.vx += (mx * player.speed - player.vx) * Math.min(1, accel * dt);
                player.vy += (my * player.speed - player.vy) * Math.min(1, accel * dt);
            }

            player.x += player.vx * dt;
            player.y += player.vy * dt;

            // Keep inside bounds
            const pad = player.radius + 6;
            player.x = Math.max(pad, Math.min(width - pad, player.x));
            player.y = Math.max(pad, Math.min(height - pad, player.y));

            // Shooting
            player.fireTimer -= dt;
            if ((mouse.down || mouse.autoFire) && player.fireTimer <= 0) {
                fireWeapon();
                player.fireTimer = player.fireDelay;
            }

            // Update Orbitals
            const orbSpeed = 3.4;
            orbitals.forEach((orb) => {
                orb.angleOffset += orbSpeed * dt;
                orb.x = player.x + Math.cos(orb.angleOffset) * orb.dist;
                orb.y = player.y + Math.sin(orb.angleOffset) * orb.dist;

                // Check collision with enemies
                for (let i = enemies.length - 1; i >= 0; i--) {
                    const e = enemies[i];
                    if (Math.hypot(e.x - orb.x, e.y - orb.y) < e.radius + orb.radius) {
                        damageEnemy(e, player.damage * 1.8 * dt * 15);
                        spawnParticles(orb.x, orb.y, '#00e676', 1, 70);
                    }
                }
            });

            // Update Player Bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                const b = bullets[i];
                b.x += b.vx * dt;
                b.y += b.vy * dt;

                // Wall Bounce or Remove
                let out = false;
                if (b.x < b.radius || b.x > width - b.radius) {
                    if (b.bounces > 0) {
                        b.vx *= -1;
                        b.bounces -= 1;
                        b.x = Math.max(b.radius, Math.min(width - b.radius, b.x));
                        spawnParticles(b.x, b.y, b.color, 4, 90);
                    } else out = true;
                }
                if (b.y < b.radius || b.y > height - b.radius) {
                    if (b.bounces > 0) {
                        b.vy *= -1;
                        b.bounces -= 1;
                        b.y = Math.max(b.radius, Math.min(height - b.radius, b.y));
                        spawnParticles(b.x, b.y, b.color, 4, 90);
                    } else out = true;
                }

                if (out) {
                    bullets.splice(i, 1);
                    continue;
                }

                // Hit Enemies
                for (let j = enemies.length - 1; j >= 0; j--) {
                    const e = enemies[j];
                    if (b.hitIds.has(e.id)) continue;
                    const dist = Math.hypot(e.x - b.x, e.y - b.y);
                    if (dist < e.radius + b.radius) {
                        b.hitIds.add(e.id);
                        spawnParticles(b.x, b.y, b.color, 5, 130);
                        damageEnemy(e, b.damage, b.pierce > 0);

                        if (b.pierce > 0) {
                            b.pierce -= 1;
                        } else {
                            bullets.splice(i, 1);
                            break;
                        }
                    }
                }
            }

            // Update Enemy Bullets
            for (let i = enemyBullets.length - 1; i >= 0; i--) {
                const eb = enemyBullets[i];
                eb.x += eb.vx * dt;
                eb.y += eb.vy * dt;

                if (eb.x < -20 || eb.x > width + 20 || eb.y < -20 || eb.y > height + 20) {
                    enemyBullets.splice(i, 1);
                    continue;
                }

                if (player.invulnTimer <= 0 && Math.hypot(eb.x - player.x, eb.y - player.y) < eb.radius + player.radius - 2) {
                    enemyBullets.splice(i, 1);
                    damagePlayer(14);
                }
            }

            // Update Enemies
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                if (e.flashTimer > 0) e.flashTimer -= dt;

                const ang = Math.atan2(player.y - e.y, player.x - e.x);
                e.angle += dt * (e.type === 'dasher' ? 5 : 2.2);

                // Movement & Shooter logic
                const distToPlayer = Math.hypot(player.x - e.x, player.y - e.y);

                if (e.type === 'shooter' && distToPlayer < 260) {
                    // Keep slight distance and strafe
                    e.vx = Math.cos(ang + Math.PI * 0.65) * e.speed;
                    e.vy = Math.sin(ang + Math.PI * 0.65) * e.speed;
                } else {
                    e.vx = Math.cos(ang) * e.speed;
                    e.vy = Math.sin(ang) * e.speed;
                }

                e.x += e.vx * dt;
                e.y += e.vy * dt;

                // Soft separation between enemies
                for (let j = i - 1; j >= 0; j--) {
                    const other = enemies[j];
                    const dx = e.x - other.x;
                    const dy = e.y - other.y;
                    const d = Math.hypot(dx, dy);
                    const minD = e.radius + other.radius;
                    if (d > 0 && d < minD) {
                        const push = (minD - d) * 0.5;
                        const nx = dx / d;
                        const ny = dy / d;
                        e.x += nx * push;
                        e.y += ny * push;
                        other.x -= nx * push;
                        other.y -= ny * push;
                    }
                }

                // Ranged attack for shooter & boss
                if (e.type === 'shooter' || e.type === 'boss') {
                    e.shootTimer -= dt;
                    if (e.shootTimer <= 0) {
                        if (e.type === 'shooter') {
                            e.shootTimer = Math.max(1.1, 2.2 - wave * 0.05);
                            enemyBullets.push({
                                x: e.x,
                                y: e.y,
                                vx: Math.cos(ang) * 310,
                                vy: Math.sin(ang) * 310,
                                radius: 5.5,
                                color: '#ff00e5'
                            });
                        } else {
                            // Boss fires radial burst
                            e.shootTimer = 1.6;
                            const burst = 8;
                            for (let k = 0; k < burst; k++) {
                                const bAng = ang + (Math.PI * 2 * k) / burst;
                                enemyBullets.push({
                                    x: e.x,
                                    y: e.y,
                                    vx: Math.cos(bAng) * 280,
                                    vy: Math.sin(bAng) * 280,
                                    radius: 6.5,
                                    color: '#ff1744'
                                });
                            }
                        }
                    }
                }

                // Player collision
                if (distToPlayer < e.radius + player.radius - 2) {
                    if (player.dashTimer > 0) {
                        // Ramming damage during Phase Dash
                        damageEnemy(e, player.damage * 2.5, true);
                    } else if (player.invulnTimer <= 0) {
                        damagePlayer(e.type === 'boss' ? 30 : 18);
                    }
                }
            }

            // Update XP Gems & Health Orbs
            for (let i = xpGems.length - 1; i >= 0; i--) {
                const g = xpGems[i];
                g.vx *= 0.92;
                g.vy *= 0.92;

                const d = Math.hypot(player.x - g.x, player.y - g.y);
                if (d < player.magnetRadius) {
                    const pull = (1 - d / player.magnetRadius) * 620 + 180;
                    const ang = Math.atan2(player.y - g.y, player.x - g.x);
                    g.vx = Math.cos(ang) * pull;
                    g.vy = Math.sin(ang) * pull;
                }

                g.x += g.vx * dt;
                g.y += g.vy * dt;

                if (d < player.radius + g.radius + 6) {
                    xpGems.splice(i, 1);
                    if (g.heal) {
                        player.hp = Math.min(player.maxHp, player.hp + g.heal);
                        spawnFloatingText(player.x, player.y - 20, `+${g.heal} HP`, '#00e676');
                    } else {
                        player.xp += g.val;
                        checkLevelUp();
                    }
                    updateHUD();
                }
            }

            // Update Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx * dt;
                p.y += p.vy * dt;
                p.vx *= 0.94;
                p.vy *= 0.94;
                p.life -= dt;
                if (p.life <= 0) particles.splice(i, 1);
            }

            // Update Shockwaves
            for (let i = shockwaves.length - 1; i >= 0; i--) {
                const sw = shockwaves[i];
                sw.radius += (sw.maxRadius - sw.radius) * 8 * dt;
                sw.alpha -= dt * 1.8;
                if (sw.alpha <= 0) shockwaves.splice(i, 1);
            }

            // Update Floating Texts
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                const ft = floatingTexts[i];
                ft.y -= 38 * dt;
                ft.life -= dt;
                if (ft.life <= 0) floatingTexts.splice(i, 1);
            }

            updateHUD();
        }

        function damagePlayer(amount) {
            player.hp -= amount;
            player.invulnTimer = 0.65;
            screenShake = 16;
            combo = 1;
            sfx.playExplosion(1.3);
            spawnParticles(player.x, player.y, '#ff1744', 20, 220);
            spawnFloatingText(player.x, player.y - 25, `-${amount} HP`, '#ff1744');
            updateHUD();

            if (player.hp <= 0) {
                triggerGameOver();
            }
        }

        // =========================================================================
        // RENDERING
        // =========================================================================
        function drawPolygon(x, y, radius, sides, rotation) {
            ctx.beginPath();
            for (let i = 0; i < sides; i++) {
                const a = rotation + (i * Math.PI * 2) / sides;
                const px = x + Math.cos(a) * radius;
                const py = y + Math.sin(a) * radius;
                if (i === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.closePath();
        }

        function render() {
            ctx.save();

            // Trail fade background
            ctx.fillStyle = 'rgba(5, 5, 12, 0.38)';
            ctx.fillRect(0, 0, width, height);

            // Apply Screen Shake
            if (screenShake > 0) {
                const sx = (Math.random() - 0.5) * screenShake;
                const sy = (Math.random() - 0.5) * screenShake;
                ctx.translate(sx, sy);
            }

            // Reactive Cyber Grid
            const gridSize = 55;
            const baseAlpha = 0.06 + gridPulse * 0.08;
            ctx.strokeStyle = `rgba(0, 243, 255, ${baseAlpha})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            for (let x = 0; x < width; x += gridSize) {
                ctx.moveTo(x, 0);
                ctx.lineTo(x, height);
            }
            for (let y = 0; y < height; y += gridSize) {
                ctx.moveTo(0, y);
                ctx.lineTo(width, y);
            }
            ctx.stroke();

            if (!player) {
                ctx.restore();
                return;
            }

            // Shockwaves
            shockwaves.forEach((sw) => {
                ctx.save();
                ctx.beginPath();
                ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
                ctx.strokeStyle = sw.color;
                ctx.globalAlpha = Math.max(0, sw.alpha);
                ctx.lineWidth = sw.lineWidth;
                ctx.shadowColor = sw.color;
                ctx.shadowBlur = 16;
                ctx.stroke();
                ctx.restore();
            });

            // XP Gems & Orbs
            xpGems.forEach((g) => {
                ctx.save();
                ctx.shadowColor = g.color;
                ctx.shadowBlur = 12;
                ctx.fillStyle = g.color;
                ctx.beginPath();
                ctx.arc(g.x, g.y, g.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Particles
            particles.forEach((p) => {
                ctx.save();
                ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
                ctx.fillStyle = p.color;
                ctx.shadowColor = p.color;
                ctx.shadowBlur = 10;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Bullets
            bullets.forEach((b) => {
                ctx.save();
                ctx.fillStyle = '#fff';
                ctx.shadowColor = b.color;
                ctx.shadowBlur = 14;
                ctx.beginPath();
                ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Enemy Bullets
            enemyBullets.forEach((eb) => {
                ctx.save();
                ctx.fillStyle = eb.color;
                ctx.shadowColor = eb.color;
                ctx.shadowBlur = 12;
                ctx.beginPath();
                ctx.arc(eb.x, eb.y, eb.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Enemies
            enemies.forEach((e) => {
                ctx.save();
                const col = e.flashTimer > 0 ? '#ffffff' : e.color;
                ctx.strokeStyle = col;
                ctx.fillStyle = e.flashTimer > 0 ? '#ffffff' : 'rgba(10, 12, 24, 0.85)';
                ctx.lineWidth = e.type === 'boss' ? 4 : 2.5;
                ctx.shadowColor = e.color;
                ctx.shadowBlur = 16;

                drawPolygon(e.x, e.y, e.radius, e.sides, e.angle);
                ctx.fill();
                ctx.stroke();

                // HP bar for Tanks and Bosses
                if ((e.type === 'tank' || e.type === 'boss') && e.hp < e.maxHp) {
                    const bw = e.radius * 1.8;
                    const bh = 5;
                    ctx.fillStyle = 'rgba(0,0,0,0.6)';
                    ctx.fillRect(e.x - bw / 2, e.y - e.radius - 14, bw, bh);
                    ctx.fillStyle = e.color;
                    ctx.fillRect(e.x - bw / 2, e.y - e.radius - 14, bw * (e.hp / e.maxHp), bh);
                }
                ctx.restore();
            });

            // Orbitals
            orbitals.forEach((orb) => {
                ctx.save();
                ctx.fillStyle = '#00e676';
                ctx.shadowColor = '#00e676';
                ctx.shadowBlur = 14;
                ctx.beginPath();
                ctx.arc(orb.x, orb.y, orb.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Player Ship
            ctx.save();
            ctx.translate(player.x, player.y);
            ctx.rotate(player.angle);

            const shipColor = player.invulnTimer > 0 && Math.floor(performance.now() / 60) % 2 === 0
                ? '#ffffff'
                : player.dashTimer > 0
                    ? '#d500f9'
                    : '#00f3ff';

            ctx.strokeStyle = shipColor;
            ctx.fillStyle = 'rgba(0, 243, 255, 0.15)';
            ctx.lineWidth = 2.8;
            ctx.shadowColor = shipColor;
            ctx.shadowBlur = 18;

            ctx.beginPath();
            ctx.moveTo(20, 0);
            ctx.lineTo(-14, -13);
            ctx.lineTo(-8, 0);
            ctx.lineTo(-14, 13);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.restore();

            // Floating Combat Text
            floatingTexts.forEach((ft) => {
                ctx.save();
                ctx.font = '700 15px Orbitron, sans-serif';
                ctx.fillStyle = ft.color;
                ctx.globalAlpha = Math.max(0, ft.life / ft.maxLife);
                ctx.shadowColor = ft.color;
                ctx.shadowBlur = 8;
                ctx.textAlign = 'center';
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.restore();
            });

            // Pause Overlay Text
            if (gameState === 'PAUSED') {
                ctx.save();
                ctx.fillStyle = 'rgba(5, 6, 15, 0.55)';
                ctx.fillRect(0, 0, width, height);
                ctx.font = '900 42px Orbitron, sans-serif';
                ctx.fillStyle = '#00f3ff';
                ctx.textAlign = 'center';
                ctx.shadowColor = '#00f3ff';
                ctx.shadowBlur = 20;
                ctx.fillText('SYSTEM PAUSED', width / 2, height / 2);
                ctx.font = '500 18px Rajdhani, sans-serif';
                ctx.fillStyle = '#e0f7fa';
                ctx.fillText('Press ESC or P to Resume', width / 2, height / 2 + 40);
                ctx.restore();
            }

            ctx.restore();
        }

        function loop(now) {
            const dt = Math.min(0.05, (now - lastTime) / 1000);
            lastTime = now;

            update(dt);
            render();
            requestAnimationFrame(loop);
        }

        // =========================================================================
        // BUTTON LISTENERS
        // =========================================================================
        document.getElementById('startBtn').addEventListener('click', () => {
            sfx.init();
            document.getElementById('startScreen').classList.add('hidden');
            resetGame();
            gameState = 'PLAYING';
        });

        document.getElementById('restartBtn').addEventListener('click', () => {
            sfx.init();
            document.getElementById('gameOverScreen').classList.add('hidden');
            resetGame();
            gameState = 'PLAYING';
        });

        // Initialize background preview & start loop
        resetGame();
        gameState = 'START';
        requestAnimationFrame(loop);
    </script>
</body>

</html>