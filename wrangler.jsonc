{
  "name": "neon-overdrive-arena",
  "main": "worker.js",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin"]
  },
  "kv_namespaces": [
    {
      "binding": "Leaderboard-Score",
      "id": "9a2a861eb9574927872342c9ffd6ba33"
    }
  ],
  "vars": {
    "ADMIN_KEY": "OVERLORD"
  }
}

